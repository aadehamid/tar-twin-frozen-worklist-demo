# Local development defaults. On hosted exe.dev VM, store real secrets in /opt/tar-twin/.env (mode 600).
AUTH_MODE=local
EDGE_AUTH_SECRET=local-dev-edge-secret-change-me
JWT_SECRET=local-dev-jwt-secret-change-me
TWIN_SYNC_TOKEN=local-dev-twin-sync-token
TWIN_RAISE_TOKEN=local-dev-twin-raise-token
POSTGRES_DB=impactweb
POSTGRES_USER=impactweb
POSTGRES_PASSWORD=impactweb-local-pass
NEO4J_PASSWORD=neo4j-local-pass
FACILITATOR_EMAILS=facilitator@demo.local
FACILITATOR_EMAIL=facilitator@demo.local
FACILITATOR_PASSWORD=demo-pass-2028

# Optional OpenRouter AI matcher (leave DECIDER_API_KEY empty for deterministic rules + recorded fixtures)
DECIDER_API_KEY=
DECIDER_URL=https://openrouter.ai/api/alpha/decisions
DECIDER_MODEL=perplexity/pplx-decider-v1.3:free
REASON_MODEL=thinkingmachines/inkling-2-mini
