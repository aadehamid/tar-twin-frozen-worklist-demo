# AI matcher (OpenRouter Decisions API). Leave DECIDER_API_KEY empty to run rules-only matching.
# Switch DECIDER_MODEL to ~perplexity/pplx-decider-latest once that alias serves v1.3.
DECIDER_URL=https://openrouter.ai/api/alpha/decisions
DECIDER_MODEL=perplexity/pplx-decider-v1.3:free
DECIDER_API_KEY=
# Writes the one-line reason shown to planners. Display only, never changes a pick. Empty disables it.
REASON_URL=https://openrouter.ai/api/v1/chat/completions
REASON_MODEL=thinkingmachines/inkling-2-mini

# Twin graph store
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changethis

# IMPACT Web mock database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=impactweb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
