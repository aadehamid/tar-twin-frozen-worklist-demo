CREATE INDEX pipetee_key IF NOT EXISTS FOR (n:PipeTee) ON (n.key);
CREATE INDEX scopeitem_key IF NOT EXISTS FOR (n:ScopeItem) ON (n.key);
CREATE INDEX valve_key IF NOT EXISTS FOR (n:Valve) ON (n.key);
